# Firebase web app config (Project settings -> Your apps). Copy to .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# reCAPTCHA Enterprise site key used by App Check.
VITE_APPCHECK_SITE_KEY=
# An App Check debug token, for cloud requests from the dev server, does not
# go in this file. Put VITE_APPCHECK_DEBUG_TOKEN in .env.development.local,
# which only the dev server reads. A production build refuses to run if it is set.
